DELIMITER //
CREATE FUNCTION calc_bonus(
    sal INT
)
RETURNS INT
DETERMINISTIC
BEGIN
    DECLARE bonus INT;

    SET bonus = sal * 0.10;

    RETURN bonus;
END //
