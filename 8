DELIMITER //
CREATE FUNCTION get_grade(
    marks INT
)
RETURNS VARCHAR(10)
DETERMINISTIC
BEGIN
    DECLARE grade VARCHAR(10);

    IF marks >= 90 THEN
        SET grade = 'A';
    ELSEIF marks >= 75 THEN
        SET grade = 'B';
    ELSE
        SET grade = 'C';
    END IF;

    RETURN grade;
END //
